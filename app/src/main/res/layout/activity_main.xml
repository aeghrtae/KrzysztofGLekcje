<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#CBAED7"
    android:paddingLeft="50dp"


    >

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="#5A306B"
        android:padding="20dp"
        android:textColor="@color/white"
        android:textSize="20sp"

        >

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Przezroczystość : 100%"
            android:textColor="@color/white"
            android:textSize="20sp"
            />
        <TextView
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) +10/-10"

            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aktualna wartosc: 100% "
            android:textColor="@color/white"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"

            >

            <Button
                android:id="@+id/dodaj10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+10%"
                android:layout_marginRight="25dp"

                />
            <Button
                android:id="@+id/odejmij10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-10%"
                />
        </LinearLayout>

        <TextView
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2) Suwak"

            />
        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/radiogroupbtn"
            android:orientation="horizontal">
            <RadioButton
                android:textSize="12sp"
                android:id="@+id/tlo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tylko tło"
                android:textColor="@color/white"

                />
            <RadioButton
                android:textSize="12sp"
                android:id="@+id/tekst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tylko tekst"
                android:textColor="@color/white"

                />
            <RadioButton
                android:textSize="12sp"
                android:id="@+id/calyPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Caly panel"
                android:textColor="@color/white"

                />
        </RadioGroup>

    </LinearLayout>

</LinearLayout>